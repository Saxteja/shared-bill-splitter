{
  "name": "bill-splitter-task",
  "private": true,
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"pnpm --filter bill-splitter-api dev\" \"pnpm --filter bill-splitter-web dev\"",
    "build": "pnpm --filter bill-splitter-web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter bill-splitter-api test",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "concurrently": "^10.0.6"
  },
  "packageManager": "pnpm@10.28.2+sha512.41872f037ad22f7348e3b1debbaf7e867cfd448f2726d9cf74c08f19507c31d2c8e7a11525b983febc2df640b5438dee6023ebb1f84ed43cc2d654d2bc326264"
}
